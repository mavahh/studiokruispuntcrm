# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Geheim: enkel op de server (Vercel env), nooit in de browser
SUPABASE_SERVICE_ROLE_KEY=

# Publieke URL van de CRM (voor links in e-mails)
NEXT_PUBLIC_SITE_URL=https://crm.studiokruispunt.be

# E-mailmeldingen via Resend (optioneel; zonder key enkel meldingen in de app)
RESEND_API_KEY=
EMAIL_FROM="Studio Kruispunt CRM <crm@studiokruispunt.be>"

# Outreach: mails versturen vanuit de CRM (via Resend, domein moet geverifieerd zijn).
# Afzender wordt "Voornaam | Studio Kruispunt <OUTREACH_FROM>", antwoorden gaan naar je eigen e-mailadres.
OUTREACH_FROM=hallo@studiokruispunt.be

# AI-mails per lead (Claude). Zonder key werken enkel de sjablonen.
ANTHROPIC_API_KEY=

# Beveiligt de dagelijkse herinneringen (Vercel Cron stuurt dit mee)
CRON_SECRET=
